-- Custom repository for cardano haskell packages, see
-- https://github.com/IntersectMBO/cardano-haskell-packages
-- for more information.
--
-- [NOTE] The "/" in the end of the URL is mandatory, or else we get a 404 NOT FOUND
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-05-06T05:39:34Z
  , cardano-haskell-packages 2026-05-05T04:28:05Z

with-compiler: ghc-9.10.3

write-ghc-environment-files: never

test-show-details: direct
tests: True

-- GHC 9.10.3 ships with containers 0.7, but some deps still require ^>= 0.6
-- cardano-api 11.0.0.0 requires plutus-core/plutus-ledger-api ^>=1.63
allow-newer:
  servant-multipart-client:random

constraints:
  cardano-api ==11.0.0.0
  , cardano-node ==11.0.0
  , aeson ==2.2.4.1
  , blockio +serialblockio
  , blockfrost-client ==0.13.0.0
  , blockfrost-client-core ==0.8.0.0
  , io-classes ==1.8.0.1
  , plutus-core ==1.63.0.0
  , plutus-ledger-api ==1.63.0.0
  , plutus-tx ==1.63.0.0
  , validation <1.2

packages:
  src/cardano-datum-formats

source-repository-package
  type: git
  location: https://github.com/j-mueller/sc-tools
  tag: e5d3e22e853ab841c6ee9601645de1bd8fb6cfa5
  --sha256: sha256-5qG4G6XTE32V3ybJ0NPfO4j5Q95qxf1CEMK8zlvT1zI=
  subdir:
    src/devnet
    src/coin-selection
    src/mockchain
    src/optics
    src/wallet
    src/base
    src/node-client
    src/blockfrost
